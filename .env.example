# Configuração do PlayBeach — copie para `.env` e preencha com os valores do seu backend.
# Este arquivo NÃO deve conter valores reais. Nunca comite o `.env`.
#
# Todas as variáveis abaixo são PUBLICÁVEIS (a chave é a anon/publishable key,
# protegida por RLS). Segredos privados não ficam em arquivo: são cadastrados
# em Project Settings → Secrets e lidos apenas dentro de server functions.

# --- Lido no browser (import.meta.env.VITE_*) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel-anon"
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# --- Lido no servidor (process.env.*, dentro dos handlers) ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel-anon"
SUPABASE_PROJECT_ID="seu-project-id"
